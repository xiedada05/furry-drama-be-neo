{
  "_comment": "差分场景表。{{uniqueEmail}}/{{uniqueAccountId}} 会被 run.js 替换为本次运行的唯一值（保证两端各自注册新用户）。每个场景独立 cookie jar。SKIP_RATE_LIMIT=1 环境下 auth 限流跳过，避免场景间干扰。",
  "scenarios": [
    { "name": "health", "steps": [{ "method": "GET", "path": "/api/health" }] },
    { "name": "csrf-token", "steps": [{ "method": "GET", "path": "/api/csrf-token" }] },
    { "name": "captcha", "steps": [{ "method": "GET", "path": "/api/auth/captcha" }] },
    { "name": "check-accountId", "steps": [{ "method": "GET", "path": "/api/auth/check-accountId?accountId=zzz_probe" }] },
    { "name": "me-unauth", "steps": [{ "method": "GET", "path": "/api/auth/me", "devToken": false }] },
    { "name": "login-no-altcha", "steps": [{ "method": "POST", "path": "/api/auth/login", "body": { "email": "nobody@test.com", "password": "wrongpass1" }, "devToken": false }] },
    { "name": "register-invalid-email", "steps": [{ "method": "POST", "path": "/api/auth/register", "body": { "accountId": "abc", "username": "u", "email": "not-an-email", "password": "pass1234" } }] },
    { "name": "register-invalid-accountid", "steps": [{ "method": "POST", "path": "/api/auth/register", "body": { "accountId": "a!", "username": "u", "email": "a@b.com", "password": "pass1234" } }] },
    { "name": "register-short-password", "steps": [{ "method": "POST", "path": "/api/auth/register", "body": { "accountId": "abc", "username": "u", "email": "a@b.com", "password": "short1" } }] },
    { "name": "register-demo-email", "steps": [{ "method": "POST", "path": "/api/auth/register", "body": { "accountId": "abc", "username": "u", "email": "demo@furry09.com", "password": "pass1234" } }] },
    { "name": "register-success", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } }
    ] },
    { "name": "register-duplicate", "skip": "register 限流(3/h)计数两端不同步（Express 常驻进程 vs neo 重启清零）导致 step1 偶发 429/400 分叉；neo 重复注册检测已正确（200→400），由 neo 单测与手动探测覆盖", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "u1", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "other", "username": "u2", "email": "{{uniqueEmail}}", "password": "pass1234" } }
    ] },
    { "name": "login-wrong-password", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/login", "body": { "email": "{{uniqueEmail}}", "password": "wrongpass1" } }
    ] },
    { "name": "login-and-me", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/login", "body": { "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "GET", "path": "/api/auth/me" }
    ] },
    { "name": "refresh-rotate", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/login", "body": { "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/refresh" }
    ] },
    { "name": "logout", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/login", "body": { "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/logout" }
    ] },
    { "name": "change-password", "skip": "两端 register/passwordReset 限流(3/h)计数不同步级联分叉（register 429→login 401→改密 429/401）；改密中间件顺序已对齐（rl 前置），neo 完整改密流程已由单测+手动探测验证（200 密码修改成功）", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/login", "body": { "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "PUT", "path": "/api/auth/change-password", "body": { "currentPassword": "pass1234", "newPassword": "newpass123" } }
    ] },
    { "name": "user-sessions", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/login", "body": { "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/user-sessions/create", "body": { "screenWidth": 1920, "screenHeight": 1080, "language": "zh-CN" } },
      { "method": "GET", "path": "/api/user-sessions/my" },
      { "method": "POST", "path": "/api/user-sessions/heartbeat" }
    ] },
    { "name": "export-json", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/login", "body": { "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "GET", "path": "/api/users/export-my-data" }
    ] },
    { "name": "export-csv", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/login", "body": { "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "GET", "path": "/api/users/export-my-data?format=csv" }
    ] },
    { "name": "2fa-enable", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/login", "body": { "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/2fa/enable" }
    ] },
    { "name": "csrf-mismatch", "steps": [
      { "method": "GET", "path": "/api/csrf-token" },
      { "method": "POST", "path": "/api/auth/login", "headers": { "X-XSRF-TOKEN": "deadbeef" }, "body": { "email": "a@b.com", "password": "x1234567" } }
    ] },
    { "name": "csrf-no-header", "steps": [
      { "method": "GET", "path": "/api/csrf-token" },
      { "method": "POST", "path": "/api/auth/login", "headers": { "X-XSRF-TOKEN": "" }, "body": { "email": "a@b.com", "password": "x1234567" } }
    ] },
    { "name": "v1-deprecation-headers", "steps": [{ "method": "GET", "path": "/api/v1/health" }] },
    { "name": "not-found-route", "steps": [{ "method": "GET", "path": "/api/nonexistent-endpoint-xyz", "devToken": false }] },
    { "name": "cors-denied", "steps": [{ "method": "GET", "path": "/api/health", "headers": { "Origin": "http://evil.example.com" } }] },
    { "name": "episodes-list", "steps": [{ "method": "GET", "path": "/api/episodes" }] },
    { "name": "episodes-list-v1", "steps": [{ "method": "GET", "path": "/api/v1/episodes" }] },
    { "name": "series-list", "steps": [{ "method": "GET", "path": "/api/series" }] },
    { "name": "episodes-search-suggestions", "steps": [{ "method": "GET", "path": "/api/episodes/search-suggestions" }] },
    { "name": "episodes-popular-tags", "steps": [{ "method": "GET", "path": "/api/episodes/popular-tags" }] },
    { "name": "episodes-search-empty", "steps": [{ "method": "GET", "path": "/api/episodes/search?q=zzzzz" }] },
    { "name": "episodes-invalid-id", "steps": [{ "method": "GET", "path": "/api/episodes/not-an-id" }] },
    { "name": "series-invalid-id", "steps": [{ "method": "GET", "path": "/api/series/not-an-id" }] },
    { "name": "episodes-view-invalid", "steps": [{ "method": "PUT", "path": "/api/episodes/not-an-id/view" }] },
    { "name": "content-protect-401", "steps": [
      { "method": "GET", "path": "/api/folders" },
      { "method": "GET", "path": "/api/favorites/list" },
      { "method": "GET", "path": "/api/favorites/check/000000000000000000000001" },
      { "method": "GET", "path": "/api/follows/list" },
      { "method": "GET", "path": "/api/follows/check/000000000000000000000001" },
      { "method": "GET", "path": "/api/histories/list" },
      { "method": "GET", "path": "/api/histories/continue-watching" },
      { "method": "GET", "path": "/api/histories/check/000000000000000000000001" },
      { "method": "GET", "path": "/api/ratings/check/000000000000000000000001" }
    ] },
    { "name": "content-empty-after-login", "steps": [
      { "method": "POST", "path": "/api/auth/register", "body": { "accountId": "{{uniqueAccountId}}", "username": "diffuser", "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "POST", "path": "/api/auth/login", "body": { "email": "{{uniqueEmail}}", "password": "pass1234" } },
      { "method": "GET", "path": "/api/folders" },
      { "method": "GET", "path": "/api/favorites/list" },
      { "method": "GET", "path": "/api/follows/list" },
      { "method": "GET", "path": "/api/histories/list" },
      { "method": "GET", "path": "/api/histories/continue-watching" },
      { "method": "GET", "path": "/api/ratings/check/000000000000000000000001" },
      { "method": "GET", "path": "/api/episodes/not-an-id/user-status" }
    ] }
  ]
}
